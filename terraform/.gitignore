# Local .terraform directories
**/.terraform/*

# .tfstate files
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Exclude override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Ignore any .tfvars files that are generated automatically
*.tfvars

# Ignore override files as they'll be generated when needed
*_override.tf
